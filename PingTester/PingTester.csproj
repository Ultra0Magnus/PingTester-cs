<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- Métadonnées de release 0.2 -->
    <Version>0.2.0</Version>
    <FileVersion>0.2.0.0</FileVersion>
    <InformationalVersion>0.2.0</InformationalVersion>
    <Product>PingTester</Product>
    <Authors>Ultra0Magnus</Authors>
    <Copyright>© 2026 Ultra0Magnus</Copyright>
    <Description>Outil de test et surveillance de ping pour Windows (graphe live, stats, test de débit). Port C#/Avalonia de PingTester.</Description>
    <RepositoryUrl>https://github.com/Ultra0Magnus/PingTester-cs</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia 11.3.4 — même version que ScottPlot.Avalonia 5.1.58 -->
    <PackageReference Include="Avalonia"               Version="11.3.4" />
    <PackageReference Include="Avalonia.Desktop"       Version="11.3.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.4" />
    <PackageReference Include="Avalonia.Fonts.Inter"   Version="11.3.4" />
    <PackageReference Include="CommunityToolkit.Mvvm"  Version="8.4.2"  />
    <PackageReference Include="ScottPlot.Avalonia"     Version="5.1.58" />
  </ItemGroup>
</Project>
