<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PingTester.ViewModels"
        xmlns:sp="using:ScottPlot.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
        x:Class="PingTester.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PingTester"
        Icon="/Assets/app.ico"
        Width="900" Height="580"
        MinWidth="680" MinHeight="440"
        Background="#1e1e2e"
        TransparencyLevelHint="None">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ═══ Barre d'outils ══════════════════════════════════════════════ -->
        <Border Grid.Row="0" Padding="12,8,12,6">
            <!-- WrapPanel : les groupes passent à la ligne si la fenêtre est trop étroite -->
            <WrapPanel Orientation="Horizontal">

                <!-- Groupe 1 : Hôtes + bouton démarrer -->
                <StackPanel Orientation="Horizontal" Spacing="8"
                            Margin="0,0,12,4" VerticalAlignment="Center">
                    <TextBlock Text="Hôtes :" VerticalAlignment="Center" Opacity=".8"/>
                    <TextBox Text="{Binding HostsText}"
                             IsEnabled="{Binding IsNotRunning}"
                             Width="290"
                             Watermark="8.8.8.8, 1.1.1.1, google.com"
                             VerticalContentAlignment="Center"/>
                    <Button Content="{Binding StartStopLabel}"
                            Command="{Binding StartStopCommand}"
                            MinWidth="130"
                            HorizontalContentAlignment="Center"
                            Padding="12,6"/>
                </StackPanel>

                <!-- Groupe 2 : Intervalle + Seuil -->
                <StackPanel Orientation="Horizontal" Spacing="8"
                            Margin="0,0,0,4" VerticalAlignment="Center">
                    <TextBlock Text="Intervalle :" VerticalAlignment="Center" Opacity=".8"/>
                    <NumericUpDown Value="{Binding IntervalMs}"
                                   IsEnabled="{Binding IsNotRunning}"
                                   Minimum="200" Maximum="10000"
                                   Increment="200"
                                   Width="110"
                                   FormatString="0"/>
                    <TextBlock Text="ms" VerticalAlignment="Center" Opacity=".55"/>

                    <Rectangle Width="1" Margin="4,4" Opacity=".25"
                               Fill="{DynamicResource SystemBaseMediumColor}"/>

                    <TextBlock Text="Seuil :" VerticalAlignment="Center" Opacity=".8"/>
                    <NumericUpDown Value="{Binding ThresholdMs}"
                                   Minimum="0" Maximum="5000"
                                   Increment="50"
                                   Width="120"
                                   FormatString="0"/>
                    <TextBlock Text="ms  (0 = off)" VerticalAlignment="Center" Opacity=".55"/>
                </StackPanel>

            </WrapPanel>
        </Border>

        <!-- ═══ Onglets ══════════════════════════════════════════════════════ -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">

            <!-- ── Onglet Graphe ─────────────────────────────────────────── -->
            <TabItem Header="📈 Graphe">
                <sp:AvaPlot x:Name="AvaPlot1" Margin="6,4"/>
            </TabItem>

            <!-- ── Onglet Stats ──────────────────────────────────────────── -->
            <TabItem Header="📊 Stats">
                <Grid RowDefinitions="Auto,*">

                    <!-- En-tête du tableau -->
                    <Border Grid.Row="0" Padding="14,8" Background="#252537">
                        <Grid ColumnDefinitions="*,68,68,65,65,78,78,68,62">
                            <TextBlock Grid.Column="0" Text="Hôte"    FontWeight="SemiBold" Opacity=".65"/>
                            <TextBlock Grid.Column="1" Text="Pings"   FontWeight="SemiBold" Opacity=".65"/>
                            <TextBlock Grid.Column="2" Text="Perte"   FontWeight="SemiBold" Opacity=".65"/>
                            <TextBlock Grid.Column="3" Text="Min"     FontWeight="SemiBold" Opacity=".65"/>
                            <TextBlock Grid.Column="4" Text="Max"     FontWeight="SemiBold" Opacity=".65"/>
                            <TextBlock Grid.Column="5" Text="Moyenne" FontWeight="SemiBold" Opacity=".65"/>
                            <TextBlock Grid.Column="6" Text="Médiane" FontWeight="SemiBold" Opacity=".65"/>
                            <TextBlock Grid.Column="7" Text="Gigue"   FontWeight="SemiBold" Opacity=".65"/>
                            <TextBlock Grid.Column="8" Text="Score"   FontWeight="SemiBold" Opacity=".65"
                                       HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Lignes de données -->
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Hosts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HostStateViewModel">
                                    <Border Padding="14,10"
                                            BorderThickness="0,0,0,1"
                                            BorderBrush="#2d2d44">
                                        <Grid ColumnDefinitions="*,68,68,65,65,78,78,68,62">

                                            <TextBlock Grid.Column="0" Text="{Binding Host}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Sent}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding LossText}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding MinText}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding MaxText}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding AvgText}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="6" Text="{Binding MedianText}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="7" Text="{Binding JitterText}"
                                                       VerticalAlignment="Center"/>

                                            <!-- Badge score coloré -->
                                            <Border Grid.Column="8"
                                                    Background="{Binding QualityBrush}"
                                                    CornerRadius="5" Padding="0,3"
                                                    Width="46" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding QualityScore}"
                                                           Foreground="#1e1e2e"
                                                           FontWeight="Bold" FontSize="13"
                                                           HorizontalAlignment="Center"/>
                                            </Border>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                </Grid>
            </TabItem>

            <!-- ── Onglet Débit ──────────────────────────────────────────── -->
            <TabItem Header="🚀 Débit">
                <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24,20">

                    <Button Grid.Row="0"
                            Content="{Binding SpeedTest.ButtonLabel}"
                            Command="{Binding SpeedTest.ToggleSpeedTestCommand}"
                            HorizontalAlignment="Center"
                            Padding="22,10" FontSize="14"/>

                    <ProgressBar Grid.Row="1"
                                 Minimum="0" Maximum="1"
                                 Value="{Binding SpeedTest.Progress}"
                                 Height="6" Margin="0,18,0,8"/>

                    <TextBlock Grid.Row="2"
                               Text="{Binding SpeedTest.Phase}"
                               HorizontalAlignment="Center" Opacity=".7"/>

                    <!-- Trois cartes de résultats -->
                    <Grid Grid.Row="3" ColumnDefinitions="*,*,*"
                          Margin="0,28,0,0" VerticalAlignment="Top">

                        <Border Grid.Column="0" Background="#252537"
                                CornerRadius="10" Padding="16,22" Margin="6">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <TextBlock Text="↓ Download" FontSize="13" Opacity=".7"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding SpeedTest.DownloadText}"
                                           FontSize="34" FontWeight="Bold"
                                           Foreground="#89b4fa" HorizontalAlignment="Center"/>
                                <TextBlock Text="Mbps" FontSize="12" Opacity=".5"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#252537"
                                CornerRadius="10" Padding="16,22" Margin="6">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <TextBlock Text="↑ Upload" FontSize="13" Opacity=".7"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding SpeedTest.UploadText}"
                                           FontSize="34" FontWeight="Bold"
                                           Foreground="#a6e3a1" HorizontalAlignment="Center"/>
                                <TextBlock Text="Mbps" FontSize="12" Opacity=".5"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#252537"
                                CornerRadius="10" Padding="16,22" Margin="6">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <TextBlock Text="⏱ Latence" FontSize="13" Opacity=".7"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding SpeedTest.LatencyText}"
                                           FontSize="34" FontWeight="Bold"
                                           Foreground="#f9e2af" HorizontalAlignment="Center"/>
                                <TextBlock Text="ms" FontSize="12" Opacity=".5"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </Grid>
            </TabItem>


            <!-- ── Onglet Géo-Ping ──────────────────────────────────────────── -->
            <TabItem Header="🌍 Géo-Ping">
                <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24,20">

                    <!-- Barre de recherche -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Center">
                        <TextBox Text="{Binding GeoSearch.SearchText}"
                                 Width="300"
                                 Watermark="Ex : Chicago, Tokyo, Paris…"
                                 VerticalContentAlignment="Center"/>
                        <Button Content="🔍 Rechercher"
                                Command="{Binding GeoSearch.SearchCommand}"
                                IsEnabled="{Binding GeoSearch.IsNotSearching}"
                                Padding="14,6"/>
                    </StackPanel>

                    <!-- Statut -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding GeoSearch.StatusText}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"
                               Opacity=".65" FontSize="12"/>

                    <!-- En-tête du tableau -->
                    <Border Grid.Row="2" VerticalAlignment="Top"
                            Padding="12,8" Background="#252537" Margin="0,12,0,0">
                        <Grid ColumnDefinitions="Auto,*,*,*,110">
                            <TextBlock Grid.Column="0" Width="28"/>
                            <TextBlock Grid.Column="1" Text="Serveur"      FontWeight="SemiBold" Opacity=".65"/>
                            <TextBlock Grid.Column="2" Text="Localisation" FontWeight="SemiBold" Opacity=".65"/>
                            <TextBlock Grid.Column="3" Text="FAI"          FontWeight="SemiBold" Opacity=".65"/>
                            <TextBlock Grid.Column="4" Text="Latence"      FontWeight="SemiBold" Opacity=".65"
                                       HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Lignes de résultats -->
                    <ScrollViewer Grid.Row="2" Margin="0,44,0,0">
                        <ItemsControl ItemsSource="{Binding GeoSearch.Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GeoServerRowViewModel">
                                    <Border Padding="12,10"
                                            BorderThickness="0,0,0,1"
                                            BorderBrush="#2d2d44">
                                        <Grid ColumnDefinitions="Auto,*,*,*,110">

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected}"
                                                      Margin="0,0,8,0"
                                                      VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Server.Host}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Server.Name}"
                                                       VerticalAlignment="Center" Opacity=".8"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Server.Sponsor}"
                                                       VerticalAlignment="Center" Opacity=".6"/>

                                            <!-- Badge latence coloré -->
                                            <Border Grid.Column="4"
                                                    Background="{Binding LatencyBrush}"
                                                    CornerRadius="5" Padding="0,3"
                                                    Width="90" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding LatencyText}"
                                                           Foreground="{Binding LatencyForeground}"
                                                           FontWeight="Bold" FontSize="13"
                                                           HorizontalAlignment="Center"/>
                                            </Border>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Boutons d'action -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10"
                                HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button Content="📡 Pinger"
                                Command="{Binding GeoSearch.PingSelectedCommand}"
                                IsEnabled="{Binding GeoSearch.IsNotPinging}"
                                Padding="16,8"/>
                        <Button Content="➕ Ajouter au monitoring"
                                Command="{Binding GeoSearch.AddToMonitorCommand}"
                                Padding="16,8"/>
                    </StackPanel>

                </Grid>
            </TabItem>

        </TabControl>

        <!-- ═══ Barre de statut ══════════════════════════════════════════════ -->
        <Border Grid.Row="2" Padding="10,5">
            <Grid ColumnDefinitions="*,Auto">

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Opacity=".75" FontSize="12"/>

                <!-- Chips par hôte -->
                <ItemsControl Grid.Column="1"
                              ItemsSource="{Binding Hosts}"
                              Margin="8,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HostStateViewModel">
                            <Border CornerRadius="4" Padding="8,3"
                                    Background="{DynamicResource SystemListLowColor}">
                                <TextBlock FontSize="12">
                                    <Run Text="{Binding Host}" FontWeight="SemiBold"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding Sent}"/>
                                    <Run Text=" pings · perte "/>
                                    <Run Text="{Binding LossText}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding LatencyText}"/>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>
        </Border>

    </Grid>
</Window>
