<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PingTester.ViewModels"
        xmlns:sp="using:ScottPlot.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
        x:Class="PingTester.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PingTester"
        Width="900" Height="560"
        MinWidth="620" MinHeight="420"
        Background="#1e1e2e"
        TransparencyLevelHint="None">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ═══ Barre d'outils ══════════════════════════════════════════════ -->
        <Border Grid.Row="0" Padding="12,8,12,6">
            <StackPanel Orientation="Horizontal" Spacing="8">

                <TextBlock Text="Hôtes :" VerticalAlignment="Center" Opacity=".8"/>

                <TextBox Text="{Binding HostsText}"
                         IsEnabled="{Binding IsNotRunning}"
                         Width="290"
                         Watermark="8.8.8.8, 1.1.1.1, google.com"
                         VerticalContentAlignment="Center"/>

                <Button Content="{Binding StartStopLabel}"
                        Command="{Binding StartStopCommand}"
                        MinWidth="130"
                        HorizontalContentAlignment="Center"
                        Padding="12,6"/>

                <Rectangle Width="1" Margin="4,4" Opacity=".25"
                           Fill="{DynamicResource SystemBaseMediumColor}"/>

                <TextBlock Text="Intervalle :" VerticalAlignment="Center" Opacity=".8"/>

                <NumericUpDown Value="{Binding IntervalMs}"
                               IsEnabled="{Binding IsNotRunning}"
                               Minimum="200"
                               Maximum="10000"
                               Increment="200"
                               Width="110"
                               FormatString="0"/>

                <TextBlock Text="ms" VerticalAlignment="Center" Opacity=".55"/>

            </StackPanel>
        </Border>

        <!-- ═══ Graphe ScottPlot ═════════════════════════════════════════════ -->
        <sp:AvaPlot x:Name="AvaPlot1" Grid.Row="1" Margin="6,0"/>

        <!-- ═══ Barre de statut ══════════════════════════════════════════════ -->
        <Border Grid.Row="2" Padding="10,5">
            <Grid ColumnDefinitions="*,Auto">

                <!-- Texte de statut global -->
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Opacity=".75"
                           FontSize="12"/>

                <!-- Chips par hôte -->
                <ItemsControl Grid.Column="1"
                              ItemsSource="{Binding Hosts}"
                              Margin="8,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HostStateViewModel">
                            <Border CornerRadius="4" Padding="8,3"
                                    Background="{DynamicResource SystemListLowColor}">
                                <TextBlock FontSize="12">
                                    <Run Text="{Binding Host}" FontWeight="SemiBold"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding Sent}"/>
                                    <Run Text=" pings · perte "/>
                                    <Run Text="{Binding LossText}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding LatencyText}"/>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>
        </Border>

    </Grid>
</Window>
